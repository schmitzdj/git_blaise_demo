<?xml version="1.0" encoding="utf-8"?>
<LayoutSpecification xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="Mobiliteit" Version="13" GenerateAllSections="true" GenerateClientRules="true" UseGenericPages="true">
  <Languages>
    <Language Name="NED" MappedResourceDatabaseLanguage="NED" />
  </Languages>
  <LayoutSets>
    <LayoutSet Name="Large" ResourceSetName="Large" StyleName="Amsterdam" RequiredStyle="false" DesignHeight="600" DesignWidth="800" ResizeMode="Auto" RouteItemsPerPage="4" RowsPerTable="999" ConditionAsString="Client.Width &gt; 1200 AND client.width &gt; client.height" ReceiptPageName="Default" IntroPageName="" ResumePageName="" AbortPageName="Default">
      <Parallels>
        <Parallel Name="">
          <IsGeneric>false</IsGeneric>
        </Parallel>
        <Parallel Name="PRIMARY">
          <IsGeneric>false</IsGeneric>
        </Parallel>
      </Parallels>
    </LayoutSet>
    <LayoutSet Name="Small_Touch" ResourceSetName="Small_Touch" StyleName="Amsterdam" RequiredStyle="false" DesignHeight="480" DesignWidth="320" ResizeMode="Auto" RouteItemsPerPage="1" RowsPerTable="999" ConditionAsString="Client.TouchEnabled" ReceiptPageName="Default" IntroPageName="" ResumePageName="" AbortPageName="Default">
      <Parallels>
        <Parallel Name="">
          <IsGeneric>false</IsGeneric>
        </Parallel>
        <Parallel Name="PRIMARY">
          <IsGeneric>false</IsGeneric>
        </Parallel>
      </Parallels>
    </LayoutSet>
  </LayoutSets>
  <LayoutSetGroups>
    <LayoutSetGroup Name="Interviewing" DataEntrySettingsName="StrictInterviewing">
      <LayoutSetNames>
        <string>Large</string>
        <string>Small_Touch</string>
      </LayoutSetNames>
    </LayoutSetGroup>
  </LayoutSetGroups>
  <RoleReferences>
    <RoleReference Name="Help" MappedTextRole="Help" />
    <RoleReference Name="Watermark" MappedTextRole="Watermark" />
    <RoleReference Name="ToolTip" />
    <RoleReference Name="SpecialAnswer" />
    <RoleReference Name="CategoryGroup" />
    <RoleReference Name="EditMask" />
    <RoleReference Name="Included" />
    <RoleReference Name="Excluded" />
    <RoleReference Name="Emphasized" />
    <RoleReference Name="Optional" />
    <RoleReference Name="Instructional" />
    <RoleReference Name="RANGEERROR" />
    <RoleReference Name="TabelIntro" MappedTextRole="TabelIntro" />
    <RoleReference Name="TabelHelp" MappedTextRole="TabelHelp" />
    <RoleReference Name="Post" />
  </RoleReferences>
  <TypeReferences>
    <TypeReference Name="THeader" />
    <TypeReference Name="TCurrency" />
  </TypeReferences>
  <LayoutSpecFieldReferences xmlns="layoutspec">
    <LayoutSpecFieldReference Name="RespondentTimeZone" />
    <LayoutSpecFieldReference Name="RespondentTime" />
    <LayoutSpecFieldReference Name="MainSurveyName" />
    <LayoutSpecFieldReference Name="InstrumentID" />
    <LayoutSpecFieldReference Name="InterviewerID" />
    <LayoutSpecFieldReference Name="CaseID" />
    <LayoutSpecFieldReference Name="SomeSetField" />
    <LayoutSpecFieldReference Name="JamboID" />
    <LayoutSpecFieldReference Name="ProjectID" />
    <LayoutSpecFieldReference Name="MetingID" />
    <LayoutSpecFieldReference Name="UserAgent" />
    <LayoutSpecFieldReference Name="LastReachedPage" />
    <LayoutSpecFieldReference Name="LastReachedField" />
  </LayoutSpecFieldReferences>
</LayoutSpecification>